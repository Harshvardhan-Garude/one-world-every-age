# Copy to .env (gitignored) and fill in real values. Never commit .env.
# Only the variable NAMES live here. Share actual keys with teammates over a
# private channel (Discord DM, not the repo or #general).
#
# All of these are SERVER-SIDE only. Never give them a browser-exposed prefix
# (the NEXT_PUBLIC / VITE / REACT_APP / EXPO_PUBLIC family): anything with
# those prefixes gets bundled into the game and every player can read it.

# k-ID age-adaptive tooling (exact variable names posted on the day)
KID_API_KEY=
KID_PRODUCT_ID=
# Explicit opt-in to the documented standard-product CDK Test Mode workflow.
# Leave blank until the event workspace/workflow and permission configuration are confirmed.
KID_WORKFLOW=
KID_API_BASE=https://game-api.test.k-id.com/api/v1
# Set true only after checking the product's AI permissions against docs/BACKEND.md.
KID_AI_MAPPING_CONFIRMED=false

# Inworld (TTS / STT / realtime voice): one shared team workspace
INWORLD_API_KEY=

# Modulate (voice understanding / moderation)
MODULATE_API_KEY=

# FastSpring sandbox (test transactions only)
FASTSPRING_API_USERNAME=
FASTSPRING_API_PASSWORD=

# Gemini: SDK/model configuration must be confirmed by the W06 owner.
GEMINI_API_KEY=
GEMINI_MODEL=

# Local foundation connections (nonsecret; no provider calls are made).
API_PORT=8787
COMPANION_PORT=5173
BEACON_COMPANION_ORIGIN=http://127.0.0.1:5173
# Optional exact extension origins, comma separated; empty is fine for the shell.
BEACON_EXTENSION_ORIGINS=
